{
	"name": "specrail",
	"version": "0.1.0",
	"description": "Cross-assistant spec CLI: a typed spec graph plus workflow skill distribution for coding assistants",
	"type": "module",
	"license": "Apache-2.0",
	"bin": {
		"specrail": "./dist/cli.js"
	},
	"files": [
		"dist/cli.js",
		"skills"
	],
	"engines": {
		"node": ">=20.19.0"
	},
	"packageManager": "bun@1.4.2",
	"scripts": {
		"build": "bun build src/cli.ts --target=node --outfile=dist/cli.js",
		"build:plugin": "bun scripts/build-plugin.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"dependencies": {
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@types/bun": "1.4.0",
		"typescript": "6.0.3"
	}
}
